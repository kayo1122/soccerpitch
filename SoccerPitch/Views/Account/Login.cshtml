@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5 welcome-section">
    <!-- Bubble background wrappers matching home page -->
    <div class="bubble-bg">
        <div class="blur"></div>
    </div>

    <!-- Content Layer with frosted glass card -->
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="glass-card">
                <h2 class="mb-4 text-center welcome-title">Login</h2>

                <form method="post" asp-action="Login" asp-controller="Account">
                    <div class="form-group mb-3 text-start">
                        <label for="Email" class="glass-label">Email</label>
                        <input type="email" class="form-control glass-input" id="Email" name="login" placeholder="Enter Email" />
                    </div>
                    <div class="form-group mb-4 text-start">
                        <label for="Password" class="glass-label">Password</label>
                        <input type="password" class="form-control glass-input" id="Password" name="password" placeholder="Password" />
                    </div>

                    <!-- Customized outline transparent button group matching home screen -->
                    <div class="button-group d-grid gap-2">
                        <button class="btn btn-outline-primary btn-lg glass-btn">Login</button>
                    </div>
                    <div class="mt-3 text-center">
                        <p class="glass-text">or</p>

                        <form method="post" asp-action="ExternalLogin" asp-controller="Account">
                            <input type="hidden" name="provider" value="Facebook" />
                            <input type="hidden" name="action" value="login" />

                            <button type="submit" class="btn btn-primary btn-lg w-100">
                                Login with Facebook
                            </button>
                        </form>
                        <form method="post" asp-action="ExternalLogin" asp-controller="Account">
                            <input type="hidden" name="provider" value="Google" />
                            <input type="hidden" name="action" value="login" />

                            <button type="submit" class="btn btn-danger btn-lg w-100">
                                Login with Google
                            </button>
                        </form>
                    </div>

                    <p class="mt-4 text-center glass-text">
                        Don't have an account? <a href="/Account/Register" class="glass-link">Register here</a>
                    </p>
                </form>
                
            </div>
        </div>
    </div>
</div>
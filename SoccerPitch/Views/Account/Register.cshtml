@{
    ViewData["Title"] = "Register";
}
<div class = "container mt-5 welcome-section">
    <div class="bubble-bg">
        <div class="blur"></div>
    </div>
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="glass-card">
                <h2 class="mb-4 text-center welcome-title">Create an Account</h2>

                <form method="post" asp-action="Register" asp-controller="Account">
                    <div class="form-group mb-3 text-start">
                        <label for="UserName" class="glass-label">User Name</label>
                        <input type="text" class="form-control glass-input" id="UserName" name="UserName" placeholder="Enter user name" />
                    </div>
                    <div class="form-group mb-3 text-start">
                        <label for="Email" class="glass-label">Email</label>
                        <input type="email" class="form-control glass-input" id="Email" name="Email" placeholder="Enter Email" />
                    </div>
                    <div class="form-group mb-3 text-start">
                        <label for="Password" class="glass-label">Password</label>
                        <input type="password" class="form-control glass-input" id="Password" name="Password" placeholder="Create a Password" />
                    </div>
                    <div class="form-group mb-4 text-start">
                        <label for="confirmPassword" class="glass-label">Confirm Password</label>
                        <input type="password" class="form-control glass-input" id="confirmPassword" name="confirmPassword" placeholder="Please Confirm Password" />
                    </div>
                    <div class="button-group d-grid gap-2">
                        <button class="btn btn-outline-primary btn-lg glass-btn">Register</button>
                    </div>

                    <p class="mt-4 text-center glass-text">
                        Already have an account? <a href="/Account/Login" class="glass-link">Login here</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>
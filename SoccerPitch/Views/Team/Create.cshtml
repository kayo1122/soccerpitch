@model SoccerPitch.Models.Team
@{
    ViewData["Title"] = "Create Team";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/soccerpitch.css" asp-append-version="true" />
</head>
<body>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class=team-form-container>
                    <h2 class="mb-4">Create Team</h2>

                    <form method="post" asp-controller="Team" asp-action="Create">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label class="form-label fw-bold">Team Name</label>
                            <input type="text"
                                   class="form-control"
                                   name="TeamName"
                                   placeholder="Team Name"
                                   required
                                   maxlength="100" />
                        </div>

                        <hr class="border-secondary my-4" />

                        <h5 class="mb-3">Players</h5>

                        <div id="createPlayerRows">
                            <div class="row g-2 mb-2 player-row">
                                <div class="col-7">
                                    <input type="text"
                                           class="form-control"
                                           name="Players[0].PlayerName"
                                           placeholder="Player Name"
                                           required />
                                </div>

                                <div class="col-5">
                                    <input type="text"
                                           class="form-control"
                                           name="Players[0].PreferredPosition"
                                           placeholder="Position"
                                           required />
                                </div>
                            </div>
                        </div>

                        <button type="button"
                                class="btn btn-success btn-sm mt-2"
                                onclick="addPlayerRow()">
                            + Add Player
                        </button>

                        <div class="mt-4 pt-2 border-top border-secondary d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-4">Save</button>
                            <a asp-controller="SoccerPitch" asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/soccerpitch.js" asp-append-version="true"></script>
</body>
</html>
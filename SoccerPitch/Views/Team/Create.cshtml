@{
    ViewData["Title"] = "Create Team";
    Layout = null;
}

@model SoccerPitch.Models.Team

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create team</title>
    <link rel="stylesheet" href="~/css/soccerpitch.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>

<body>
<div class="container mt-5">
    <h2>Create Team</h2>

    <form method="post" asp-controller="Team" asp-action="Create">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">Team Name</label>
            <input type="text"
                   class="form-control"
                   name="TeamName"
                   required
                   maxlength="100" />
        </div>

        <hr />

        <h5 class="mb-3">Player</h5>

        <div id="createPlayerRows">
            <div class="row g-2 mb-2 player-row">
                <div class="col-6">
                    <input type="text"
                           class="form-control"
                           name="Players[0].PlayerName"
                           placeholder="Player Name" />
                </div>

                <div class="col-6">
                    <input type="text"
                           class="form-control"
                           name="Players[0].PreferredPosition"
                           placeholder="Position" />
                </div>
            </div>
        </div>

        <button type="button"
                class="btn btn-success mt-2"
                onclick="addPlayerRow()">
            + Add Player
        </button>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-controller="SoccerPitch" asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
</body>
<script src="~/js/soccerpitch.js"></script>
</html>
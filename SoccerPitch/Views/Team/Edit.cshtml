@model SoccerPitch.Models.Team
@{
    ViewData["Title"] = "Edit Team";
    Layout = null;
    var players = Model.Players?.ToList() ?? new List<SoccerPitch.Models.Player>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/soccerpitch.css" asp-append-version="true" />
</head>
<body>

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="team-form-container">
                    <h2 class="mb-4">Edit @Model.TeamName</h2>

                    <form method="post" asp-controller="Team" asp-action="Edit" asp-route-id="@Model.TeamId">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="TeamId" value="@Model.TeamId" />

                        <div class="mb-4">
                            <label class="form-label fw-bold">Team Name</label>
                            <input type="text"
                                   class="form-control"
                                   name="TeamName"
                                   value="@Model.TeamName"
                                   required
                                   maxlength="100" />
                        </div>

                        <hr class="border-secondary my-4" />

                        <h5 class="mb-3">Players</h5>

                        <div id="editPlayerRows">
                            @for (int i = 0; i < players.Count; i++)
                            {
                                <input type="hidden" name="Players[@i].PlayerId" value="@players[i].PlayerId" />
                                <input type="hidden" name="Players[@i].TeamId" value="@Model.TeamId" />
                                <input type="hidden" name="Players[@i].OverallRating" value="@players[i].OverallRating" />
                                <input type="hidden" name="Players[@i].Goals" value="@players[i].Goals" />
                                <input type="hidden" name="Players[@i].Assists" value="@players[i].Assists" />
                                <input type="hidden" name="Players[@i].JerseyImg" value="@players[i].JerseyImg" />

                                <div class="row g-2 mb-2 player-row">
                                    <div class="col-7">
                                        <input type="text"
                                               class="form-control"
                                               name="Players[@i].PlayerName"
                                               value="@players[i].PlayerName"
                                               placeholder="Player Name"
                                               maxlength="100"
                                               required />
                                    </div>

                                    <div class="col-5">
                                        <input type="text"
                                               class="form-control"
                                               name="Players[@i].PreferredPosition"
                                               value="@players[i].PreferredPosition"
                                               placeholder="Position"
                                               maxlength="50"
                                               required />
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="mt-4 pt-2 border-top border-secondary d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                            <a asp-controller="SoccerPitch" asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/soccerpitch.js?v=3" asp-append-version="true"></script>
</body>
</html>
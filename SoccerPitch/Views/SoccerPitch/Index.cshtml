@{
    ViewData["Title"] = "Soccer Pitch";
    Layout = null;
}
@model List<SoccerPitch.Models.Team>

@{
    ViewData["Title"] = "Soccer Pitch";
    var formations = new Dictionary<string, List<(string id, string label, string top, string left)>>
    { /*formation */
        ["4-3-3"] = new()
        {
            ("gk", "GK", "85%", "46%"),
            ("lb", "LB", "65%", "15%"), ("cb1", "CB", "65%", "36%"), ("cb2", "CB", "65%", "56%"), ("rb", "RB", "65%", "77%"),
            ("cm1", "CM", "45%", "25%"), ("cm2", "CM", "45%", "46%"), ("cm3", "CM", "45%", "67%"),
            ("lw", "LW", "20%", "18%"), ("st", "ST", "18%", "46%"), ("rw", "RW", "20%", "74%")
        },
        ["4-4-2"] = new()
        {
            ("gk", "GK", "85%", "46%"),
            ("lb", "LB", "65%", "15%"), ("cb1", "CB", "65%", "36%"), ("cb2", "CB", "65%", "56%"), ("rb", "RB", "65%", "77%"),
            ("lm", "LM", "45%", "15%"), ("cm1", "CM", "45%", "36%"), ("cm2", "CM", "45%", "56%"), ("rm", "RM", "45%", "77%"),
            ("st1", "ST", "20%", "33%"), ("st2", "ST", "20%", "59%")
        },
        ["3-5-2"] = new()
        {
            ("gk", "GK", "85%", "46%"),
            ("cb1", "CB", "65%", "25%"), ("cb2", "CB", "65%", "46%"), ("cb3", "CB", "65%", "67%"),
            ("lm", "LM", "45%", "10%"), ("cm1", "CM", "45%", "28%"), ("cm2", "CM", "45%", "46%"), ("cm3", "CM", "45%", "64%"), ("rm", "RM", "45%", "82%"),
            ("st1", "ST", "20%", "33%"), ("st2", "ST", "20%", "59%")
        }
    };
}

<!DOCTYPE html>
<html lang="en">
 <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Soccer Pitch Builder</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
    background-image: url("../images/wcbackground.jpg");
    background-size: cover;
    background-position: center;
    font-family: 'Segoe UI', sans-serif;
    min-height: 100vh;
}

header {
    background: #6A4A0B;
    border-bottom: 2px solid white;
    padding: 14px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

header h1 {
    font-size: 1.4rem;
    font-weight: 700;
    color: white;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.top-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 32px;
    background: #35220E;
}

.top-bar label {
    font-size: 0.85rem;
    color: white;
    text-transform: uppercase;
    letter-spacing: 1px;
}

select {
    background: #6A4A0B;
    color: white;
    border: 1px solid white;
    border-radius: 6px;
    padding: 8px 14px;
    font-size: 0.9rem;
    cursor: pointer;
}

.save-btn {
    margin-left: auto;
    background: #2ecc71;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 9px 22px;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: background 0.2s;
}

.save-btn:hover { background: #27ae60; }

.main-layout {
    display: flex;
    gap: 0;
    height: calc(100vh - 115px);
    overflow: hidden;
}

/* PITCH */
.pitch-wrapper {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 12px;
        overflow: hidden;
}

.pitch {
    position: relative;
    width: 480px;
    height: 680px;
    background: linear-gradient(180deg,
        #2d7a3a 0%, #348f42 8.33%, #2d7a3a 8.33%,
        #2d7a3a 16.66%, #348f42 16.66%, #348f42 25%,
        #2d7a3a 25%, #2d7a3a 33.33%, #348f42 33.33%,
        #348f42 41.66%, #2d7a3a 41.66%, #2d7a3a 50%,
        #348f42 50%, #348f42 58.33%, #2d7a3a 58.33%,
        #2d7a3a 66.66%, #348f42 66.66%, #348f42 75%,
        #2d7a3a 75%, #2d7a3a 83.33%, #348f42 83.33%, #348f42 100%
    );
    border-radius: 8px;
    border: 3px solid #1a5c24;
    overflow: hidden;
}

/* Pitch lines */
.pitch-lines {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
}

/* Player slots */
.player-slot {
    position: absolute;
    transform: translate(-50%, -50%);
    z-index: 10;
    width: 70px;
    text-align: center;
}

.slot-circle {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    border: 2px dashed rgba(255,255,255,0.5);
    background: rgba(0,0,0,0.25);
    margin: 0 auto 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    color: rgba(255,255,255,0.6);
    transition: border-color 0.2s, background 0.2s;
    cursor: default;
}

.slot-circle.drag-over {
    border-color: #2ecc71;
    background: rgba(46,204,113,0.2);
    border-style: solid;
}

.slot-circle.filled {
    border-style: solid;
    border-color: #2ecc71;
    background: #1a3d28;
    flex-direction: column;
    gap: 1px;
}

.slot-circle .player-name-slot {
    font-size: 0.55rem;
    color: #e8f0e9;
    font-weight: 600;
    line-height: 1.1;
    max-width: 50px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.slot-label {
    font-size: 0.65rem;
    color: rgba(255,255,255,0.7);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
}

/* SIDEBAR */
.sidebar {
    width: 280px;
    background: #6A4A0B;
    border-left: 1px solid #1e2d3d;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.sidebar-header {
    padding: 16px;
    border-bottom: 1px solid #1e2d3d;
}

.sidebar-header h2 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #8fa89a;
    margin-bottom: 10px;
}

.team-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.team-tab {
    background: #35220E;
    border: 1px solid #2a3d50;
    border-radius: 4px;
    padding: 5px 10px;
    font-size: 0.75rem;
    cursor: pointer;
    color: white;
    transition: all 0.15s;
}

.team-tab.active {
    background: #2ecc71;
    color: #0f1923;
    border-color: #2ecc71;
    font-weight: 700;
}
/*PLAYERS*/
.player-list {
    flex: 1;
    overflow-y: auto;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
}
    
.player-list::-webkit-scrollbar { width: 4px; }
.player-list::-webkit-scrollbar-track { background: #0f1923; }
.player-list::-webkit-scrollbar-thumb { background: #2ecc71; border-radius: 2px; }

.player-card {
    background: #35220E;
    border: 1px solid #2a3d50;
    border-radius: 6px;
    padding: 10px 12px;
    cursor: grab;
    transition: border-color 0.15s, background 0.15s;
    display: flex;
    align-items: center;
    gap: 10px;
    user-select: none;
}

.player-card:hover {
    border-color: white;
    background: #1a2d3a;
}

.player-card.dragging {
    opacity: 0.4;
    cursor: grabbing;
}

.player-card.placed {
    opacity: 0.35;
    pointer-events: none;
}

.player-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #2ecc71;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
    color: #0f1923;
    flex-shrink: 0;
}

.player-info { flex: 1; overflow: hidden; }

.player-info .name {
    font-size: 0.85rem;
    font-weight: 600;
    color: #e8f0e9;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.player-info .pos {
    font-size: 0.7rem;
    color: #8fa89a;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.player-rating {
    font-size: 0.75rem;
    font-weight: 700;
    color: #2ecc71;
}

/* SUBS */
.subs-header {
    padding: 12px 16px;
    border-top: 2px solid white;
    border-bottom: 1px solid white;
}

    .subs-header h2 {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: white;
        margin: 0;
    }

.subs-list {
    overflow-y: auto;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: 220px;
    background: #6A4A0B; 
}

    .subs-list::-webkit-scrollbar { width: 4px; }
    .subs-list::-webkit-scrollbar-track { background: #35220E; }
    .subs-list::-webkit-scrollbar-thumb { background: #2ecc71; border-radius: 2px; }

.sub-slot {
    background: #35220E;        
    border: 1px dashed #2a3d50; 
    border-radius: 6px;
    padding: 8px 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    transition: border-color 0.15s, background 0.15s;
}

    .sub-slot.drag-over {
        border-color: #2ecc71;
        background: rgba(46,204,113,0.2); 
    }

    .sub-slot.filled {
        border-style: solid;
        border-color: #2ecc71;  
        background: #35220E;    

.sub-number {
    font-size: 0.7rem;
    color: #2ecc71;
    font-weight: 700;
    width: 18px;
    flex-shrink: 0;
}

.sub-empty-label {
    font-size: 0.75rem;
    color: #8fa89a; 
}

.toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background: #2ecc71;
    color: #0f1923;
    font-weight: 700;
    padding: 12px 20px;
    border-radius: 8px;
    font-size: 0.9rem;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.3s;
    z-index: 9999;
    pointer-events: none;
}

.toast.show {
    opacity: 1;
    transform: translateY(0);
}

.no-teams {
    padding: 24px;
    text-align: center;
    color: #8fa89a;
    font-size: 0.85rem;
}
        
    </style>
</head>
<body>
<header>
    <h1> Team Builder</h1>
</header>

<div class="top-bar">
    <label for="formationSelect">Formation</label>
    <select id="formationSelect" onchange="setFormation(this.value)">
        <option value="4-3-3">4-3-3</option>
        <option value="4-4-2">4-4-2</option>
        <option value="3-5-2">3-5-2</option>
    </select>
    <button class="save-btn" onclick="saveLineup()">Save Lineup</button>
</div>

<div class="main-layout">
    <div class="pitch-wrapper">
        <div class="pitch" id="pitch">
            <svg class="pitch-lines" viewBox="0 0 480 680" xmlns="http://www.w3.org/2000/svg">
                <!-- sidelines -->
                <rect x="10" y="10" width="460" height="660" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.5"/>
                <!-- Halfway line -->
                <line x1="10" y1="340" x2="470" y2="340" stroke="rgba(255,255,255,0.5)" stroke-width="1.5"/>
                <!-- Centre circle -->
                <circle cx="240" cy="340" r="60" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.5"/>
                <circle cx="240" cy="340" r="3" fill="rgba(255,255,255,0.5)"/>
                <!-- Top of penalty box -->
                <rect x="110" y="10" width="260" height="110" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.5"/>
                <rect x="170" y="10" width="140" height="55" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.5"/>
                <!-- Bottom of penalty box -->
                <rect x="110" y="560" width="260" height="110" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.5"/>
                <rect x="170" y="615" width="140" height="55" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.5"/>
                <!-- goals -->
                <rect x="190" y="5" width="100" height="12" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1"/>
                <rect x="190" y="663" width="100" height="12" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1"/>
            </svg>
        </div>
    </div>

    <div class="sidebar">
        <div class="sidebar-header">
            <h2>Teams</h2>
            <div class="team-tabs" id="teamTabs"></div>
        </div>
        <div class="player-list" id="playerList"></div>
            <div class="subs-header">
                <h2>Substitutes</h2>
            </div>
            <div class="subs-list" id="subsList"></div>
    </div>
</div>

<div class="toast" id="toast"></div>

    <script>
            const teams = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model ?? new List<SoccerPitch.Models.Team>()));
            /*team formation selection */
            const formations = {
                "4-3-3": [
                    { id: "gk",  label: "GK", top: "85%", left: "46%" },
                    { id: "lb",  label: "LB", top: "65%", left: "15%" },
                    { id: "cb1", label: "CB", top: "65%", left: "36%" },
                    { id: "cb2", label: "CB", top: "65%", left: "56%" },
                    { id: "rb",  label: "RB", top: "65%", left: "77%" },
                    { id: "cm1", label: "CM", top: "45%", left: "25%" },
                    { id: "cm2", label: "CM", top: "45%", left: "46%" },
                    { id: "cm3", label: "CM", top: "45%", left: "67%" },
                    { id: "lw",  label: "LW", top: "20%", left: "18%" },
                    { id: "st",  label: "ST", top: "18%", left: "46%" },
                    { id: "rw",  label: "RW", top: "20%", left: "74%" },
                ],
                "4-4-2": [
                    { id: "gk",  label: "GK", top: "85%", left: "46%" },
                    { id: "lb",  label: "LB", top: "65%", left: "15%" },
                    { id: "cb1", label: "CB", top: "65%", left: "36%" },
                    { id: "cb2", label: "CB", top: "65%", left: "56%" },
                    { id: "rb",  label: "RB", top: "65%", left: "77%" },
                    { id: "lm",  label: "LM", top: "45%", left: "15%" },
                    { id: "cm1", label: "CM", top: "45%", left: "36%" },
                    { id: "cm2", label: "CM", top: "45%", left: "56%" },
                    { id: "rm",  label: "RM", top: "45%", left: "77%" },
                    { id: "st1", label: "ST", top: "20%", left: "33%" },
                    { id: "st2", label: "ST", top: "20%", left: "59%" },
                ],
                "3-5-2": [
                    { id: "gk",  label: "GK", top: "85%", left: "46%" },
                    { id: "cb1", label: "CB", top: "65%", left: "25%" },
                    { id: "cb2", label: "CB", top: "65%", left: "46%" },
                    { id: "cb3", label: "CB", top: "65%", left: "67%" },
                    { id: "lm",  label: "LM", top: "45%", left: "10%" },
                    { id: "cm1", label: "CM", top: "45%", left: "28%" },
                    { id: "cm2", label: "CM", top: "45%", left: "46%" },
                    { id: "cm3", label: "CM", top: "45%", left: "64%" },
                    { id: "rm",  label: "RM", top: "45%", left: "82%" },
                    { id: "st1", label: "ST", top: "20%", left: "33%" },
                    { id: "st2", label: "ST", top: "20%", left: "59%" },
                ]
            };

            let currentFormation = "4-3-3";
            let currentTeamIndex = 0;
            let slotAssignments = {};
            let draggedPlayer = null;

            function init() {
                renderTeamTabs();
                renderPlayers();
                renderSlots();
            }

            function renderTeamTabs() {
                const tabs = document.getElementById("teamTabs");
                if (!teams || teams.length === 0) {
                    tabs.innerHTML = '<span style="color:#8fa89a;font-size:0.8rem;">No teams found</span>';
                    document.getElementById("playerList").innerHTML =
                        '<div class="no-teams">Add teams and players first.</div>';
                    return;
                }
                tabs.innerHTML = teams.map((t, i) =>
                    `<div class="team-tab ${i === currentTeamIndex ? 'active' : ''}"
                          onclick="selectTeam(${i})">${t.TeamName}</div>`
                ).join('');
            }

            function selectTeam(i) {
                currentTeamIndex = i;
                renderTeamTabs();
                renderPlayers();
            }

            function renderPlayers() {
                const list = document.getElementById("playerList");
                if (!teams || teams.length === 0) return;

                const team = teams[currentTeamIndex];
                const players = team.Players || [];

                if (players.length === 0) {
                    list.innerHTML = '<div class="no-teams">No players in this team.</div>';
                    return;
                }

                const placedIds = new Set(Object.values(slotAssignments).map(p => p.PlayerId),Object.values(subAssignments).map(p => p.PlayerId));

                list.innerHTML = players.map(p => {
                    const initials = p.PlayerName.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase();
                    const placed = placedIds.has(p.PlayerId);
                    return `
                        <div class="player-card ${placed ? 'placed' : ''}"
                             draggable="${!placed}"
                             data-player-id="${p.PlayerId}"
                             ondragstart="onDragStart(event, ${p.PlayerId})"
                             ondragend="onDragEnd(event)">
                            <div class="player-avatar">${initials}</div>
                            <div class="player-info">
                                <div class="name">${p.PlayerName}</div>
                                <div class="pos">${p.PreferredPosition}</div>
                            </div>
                            <div class="player-rating">${p.OverallRating > 0 ? p.OverallRating.toFixed(0) : '—'}</div>
                        </div>`;
                }).join('');
            }

            function renderSlots() {
                const pitch = document.getElementById("pitch");
                pitch.querySelectorAll('.player-slot').forEach(s => s.remove());

                const slots = formations[currentFormation];
                slots.forEach(slot => {
                    const assigned = slotAssignments[slot.id];
                    const div = document.createElement('div');
                    div.className = 'player-slot';
                    div.style.top = slot.top;
                    div.style.left = slot.left;
                    div.dataset.slotId = slot.id;

                    div.innerHTML = `
                        <div class="slot-circle ${assigned ? 'filled' : ''}"
                             ondragover="onDragOver(event)"
                             ondragleave="onDragLeave(event)"
                             ondrop="onDrop(event, '${slot.id}')"
                             onclick="${assigned ? `removeFromSlot('${slot.id}')` : ''}">
                            ${assigned
                                ? `<span class="player-name-slot">${assigned.PlayerName.split(' ').slice(-1)[0]}</span>
                                   <span style="font-size:0.5rem;color:#2ecc71;">${assigned.PreferredPosition}</span>`
                                : slot.label}
                        </div>
                        <div class="slot-label">${slot.label}</div>`;
                    pitch.appendChild(div);
                });
            }

            function setFormation(f) {
                currentFormation = f;
                slotAssignments = {};
                renderSlots();
                renderPlayers();
            }

            function getAllPlayers() {
                return teams.flatMap(t => t.Players || []);
            }

            function onDragStart(e, playerId) {
                draggedPlayer = getAllPlayers().find(p => p.PlayerId === playerId);
                e.target.classList.add('dragging');
                e.dataTransfer.effectAllowed = 'move';
            }

            function onDragEnd(e) {
                e.target.classList.remove('dragging');
                draggedPlayer = null;
            }

            function onDragOver(e) {
                e.preventDefault();
                e.currentTarget.classList.add('drag-over');
            }

            function onDragLeave(e) {
                e.currentTarget.classList.remove('drag-over');
            }

            function onDrop(e, slotId) {
                e.preventDefault();
                e.currentTarget.classList.remove('drag-over');
                if (!draggedPlayer) return;

                for (const [sid, p] of Object.entries(slotAssignments)) {
                    if (p.PlayerId === draggedPlayer.PlayerId) {
                        delete slotAssignments[sid];
                    }
                }

                slotAssignments[slotId] = draggedPlayer;
                renderSlots();
                renderPlayers();
            }

            function removeFromSlot(slotId) {
                delete slotAssignments[slotId];
                renderSlots();
                renderPlayers();
            }

            async function saveLineup() {
                const players = Object.entries(slotAssignments).map(([slotId, p]) => ({
                    playerId: p.PlayerId,
                    playerName: p.PlayerName,
                    position: p.PreferredPosition,
                    slotId: slotId
                }));

                if (players.length === 0) {
                    showToast("Place at least one player first!");
                    return;
                }

                const payload = { formation: currentFormation, players };

                try {
                    const res = await fetch('/SoccerPitch/SaveLineup', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const data = await res.json();
                    showToast(data.message);
                } catch {
                    showToast("Failed to save lineup.");
                }
            }

            function showToast(msg) {
                const t = document.getElementById("toast");
                t.textContent = msg;
                t.classList.add("show");
                setTimeout(() => t.classList.remove("show"), 3000);
            }
                        const MAX_SUBS = 7;
            let subAssignments = {};

            function renderSubs() {
                const list = document.getElementById("subsList");
                const placedIds = new Set(Object.values(slotAssignments).map(p => p.PlayerId));

                list.innerHTML = Array.from({ length: MAX_SUBS }, (_, i) => {
                    const player = subAssignments[i];
                    return `
                        <div class="sub-slot ${player ? 'filled' : ''}"
                             ondragover="onSubDragOver(event)"
                             ondragleave="onSubDragLeave(event)"
                             ondrop="onSubDrop(event, ${i})"
                             onclick="${player ? `removeFromSub(${i})` : ''}">
                            <span class="sub-number">${i + 12}</span>
                            ${player
                                ? `<div class="player-avatar" style="width:28px;height:28px;font-size:0.65rem;background:#2ecc71;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;color:#0f1923;">
                                        ${player.PlayerName.split(' ').map(n => n[0]).join('').slice(0,2).toUpperCase()}
                                   </div>
                                   <div class="player-info">
                                       <div class="name" style="font-size:0.78rem;">${player.PlayerName}</div>
                                       <div class="pos">${player.PreferredPosition}</div>
                                   </div>
                                   <span style="font-size:0.65rem;color:#e74c3c;cursor:pointer;">✕</span>`
                                : `<span class="sub-empty-label">Drop player here</span>`
                            }
                        </div>`;
                }).join('');
            }

            function onSubDragOver(e) {
                e.preventDefault();
                e.currentTarget.classList.add('drag-over');
            }

            function onSubDragLeave(e) {
                e.currentTarget.classList.remove('drag-over');
            }

            function onSubDrop(e, index) {
                e.preventDefault();
                e.currentTarget.classList.remove('drag-over');
                if (!draggedPlayer) return;

                // Remove from pitch slots if already placed there
                for (const [sid, p] of Object.entries(slotAssignments)) {
                    if (p.PlayerId === draggedPlayer.PlayerId) delete slotAssignments[sid];
                }
                // Remove from other sub slots
                for (const [i, p] of Object.entries(subAssignments)) {
                    if (p.PlayerId === draggedPlayer.PlayerId) delete subAssignments[i];
                }

                subAssignments[index] = draggedPlayer;
                renderSlots();
                renderPlayers();
                renderSubs();
            }

            function removeFromSub(index) {
                delete subAssignments[index];
                renderPlayers();
                renderSubs();
            }
                        function init() {
                renderTeamTabs();
                renderPlayers();
                renderSlots();
                renderSubs(); 
            }

            function setFormation(f) {
                currentFormation = f;
                slotAssignments = {};
                subAssignments = {}; 
                renderSlots();
                renderPlayers();
                renderSubs(); 
            }
            init();
    </script>
    </body>
</html>
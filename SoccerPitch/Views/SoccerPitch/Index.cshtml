@{
    ViewData["Title"] = "Soccer Pitch";
    Layout = null;
}
@model List<SoccerPitch.Models.Team>

@{
    ViewData["Title"] = "Soccer Pitch";
    var formations = new Dictionary<string, List<(string id, string label, string top, string left)>>
    { /* stores available formations and their player slot positions*/
        ["4-3-3"] = new()
        {   //goalkeeper postion
            ("gk", "GK", "85%", "46%"),
            //defense positions
            ("lb", "LB", "65%", "15%"), ("cb1", "CB", "65%", "36%"), ("cb2", "CB", "65%", "56%"), ("rb", "RB", "65%", "77%"),
            //midfield positions
            ("cm1", "CM", "45%", "25%"), ("cm2", "CM", "45%", "46%"), ("cm3", "CM", "45%", "67%"),
            //forward positions
            ("lw", "LW", "20%", "18%"), ("st", "ST", "18%", "46%"), ("rw", "RW", "20%", "74%")
        },
        ["4-4-2"] = new()
        {   //goalkeeper postion
            ("gk", "GK", "85%", "46%"),
            //defense positions
            ("lb", "LB", "65%", "15%"), ("cb1", "CB", "65%", "36%"), ("cb2", "CB", "65%", "56%"), ("rb", "RB", "65%", "77%"),
            //midfield positions
            ("lm", "LM", "45%", "15%"), ("cm1", "CM", "45%", "36%"), ("cm2", "CM", "45%", "56%"), ("rm", "RM", "45%", "77%"),
            //forward positions
            ("st1", "ST", "20%", "33%"), ("st2", "ST", "20%", "59%")
        },
        ["3-5-2"] = new()
        {   //goalkeeper postion
            ("gk", "GK", "85%", "46%"),
            //defense positions
            ("cb1", "CB", "65%", "25%"), ("cb2", "CB", "65%", "46%"), ("cb3", "CB", "65%", "67%"),
             //midfield positions
            ("lm", "LM", "45%", "10%"), ("cm1", "CM", "45%", "28%"), ("cm2", "CM", "45%", "46%"), ("cm3", "CM", "45%", "64%"), ("rm", "RM", "45%", "82%"),
            //forward positions
            ("st1", "ST", "20%", "33%"), ("st2", "ST", "20%", "59%")
        }
    };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Soccer Pitch Builder</title>
    <link rel="stylesheet" href="~/css/soccerpitch.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

</head>
<body>
    <!-- top of page-->
    <header>
        <h1> Team Builder</h1>
    </header>
    <!-- top control bar-->
    <div class="top-bar">
        <label for="formationSelect">Formation</label>
        <!--formation dropdown menu-->
        <select id="formationSelect" onchange="setFormation(this.value)">
            <option value="4-3-3">4-3-3</option>
            <option value="4-4-2">4-4-2</option>
            <option value="3-5-2">3-5-2</option>
        </select>
        <!--buttons in topbar-->
        <button type="button" class="btn-success" data-bs-toggle="modal" data-bs-target="#createTeamModal">+ Add Team</button>
        <button class="edit-team" onclick="openEditTeamModal()">Edit Team</button>
        <button class="btn btn-sm btn-danger" onclick="openDeleteTeamModal()">Delete Team</button>
        <button class="save-btn" onclick="saveLineup()">Save Lineup</button>
    </div>

    <div class="main-layout">
        <!--container for soccer field-->
        <div class="pitch-wrapper">
            <div class="pitch" id="pitch">
                <svg class="pitch-lines" viewBox="0 0 480 680" xmlns="http://www.w3.org/2000/svg">
                    <!-- sidelines -->
                    <rect x="10" y="10" width="460" height="660" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.5" />
                    <!-- Halfway line -->
                    <line x1="10" y1="340" x2="470" y2="340" stroke="rgba(255,255,255,0.5)" stroke-width="1.5" />
                    <!-- Centre circle -->
                    <circle cx="240" cy="340" r="60" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.5" />
                    <circle cx="240" cy="340" r="3" fill="rgba(255,255,255,0.5)" />
                    <!-- Top of penalty box -->
                    <rect x="110" y="10" width="260" height="110" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.5" />
                    <rect x="170" y="10" width="140" height="55" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.5" />
                    <!-- Bottom of penalty box -->
                    <rect x="110" y="560" width="260" height="110" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.5" />
                    <rect x="170" y="615" width="140" height="55" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.5" />
                    <!-- goals -->
                    <rect x="190" y="5" width="100" height="12" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1" />
                    <rect x="190" y="663" width="100" height="12" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1" />
                </svg>
            </div>
        </div>
        <!-- teams and players sidebar-->
        <div class="sidebar">
            <div class="sidebar-header">
                <!-- all available teams-->
                <h2>Teams</h2>
                <div class="team-tabs" id="teamTabs"></div>
            </div>
            <!--js fills with players from db-->
            <div class="player-list" id="playerList"></div>
            <div class="subs-header">
                <h2>Substitutes</h2>
            </div>
            <div class="subs-list" id="subsList"></div>
        </div>
    </div>

    <div class="toast" id="toast"></div>

    <!-- create team modal -->
    <div class="modal fade" id="createTeamModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <!--sends new team info to the teams controller-->
                <form method="post" asp-controller="Teams" asp-action="Create">
                    <!-- prevents fake form submission -->
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title">Add Team</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">

                        <div class="mb-3">
                            <!-- user enters team name here -->
                            <label class="form-label">Team Name</label>
                            <input type="text"
                                   class="form-control"
                                   name="TeamName"
                                   required
                                   maxlength="100" />
                        </div>
                        <hr>
                        <h5 class="mb-3">Player</h5>
                        <!-- Player information is stored inside the Players collection -->
                        <div id="createPlayerRows">
                            <div id="createPlayerRows">                   
                                <div class="row g-2 mb-2 player-row">
                                    <div class="col-6">
                                        <input type="text"
                                               class="form-control"
                                               name="Players[0].PlayerName"
                                               placeholder="Player Name" />
                                    </div>

                                    <div class="col-6">
                                        <input type="text"
                                               class="form-control"
                                               name="Players[0].PreferredPosition"
                                               placeholder="Position" />
                                    </div>
                                </div>
                            </div>

                            <button type="button"
                                    class="btn btn-success mt-2"
                                    onclick="addPlayerRow()">
                                + Add Player
                            </button>
                        </div>

                    </div>
                </form>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                
            </div>
        </div>
    </div>
    <!-- Edit team modal-->

    @foreach (var team in Model ?? new List<SoccerPitch.Models.Team>())
    { // Creates an edit modal for every team in the database.
      // Each modal gets a unique id using the TeamId.

        <div class="modal fade" id="editTeamModal-@team.TeamId" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form method="post" asp-controller="Teams" asp-action="Edit" asp-route-id="@team.TeamId">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title">Edit @team.TeamName</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" name="TeamId" value="@team.TeamId" />

                            <div class="mb-3">
                                <label class="form-label">Team Name</label>
                                <input type="text"
                                       class="form-control"
                                       name="TeamName"
                                       value="@team.TeamName"
                                       required
                                       maxlength="100" />
                            </div>
                            <hr />
                            <h5 class="mb-3">Players</h5>
                            @{
                              var players = team.Players.ToList();
                              }

                            @for (int i = 0; i < players.Count; i++)
                                {
    
                                <input type="hidden"
                                       name="Players[@i].PlayerId"
                                       value="@players[i].PlayerId" />

                                <input type="hidden"
                                       name="Players[@i].TeamId"
                                       value="@team.TeamId" />

                                <input type="hidden"
                                       name="Players[@i].OverallRating"
                                       value="@players[i].OverallRating" />

                                <input type="hidden"
                                       name="Players[@i].Goals"
                                       value="@players[i].Goals" />

                                <input type="hidden"
                                       name="Players[@i].Assists"
                                       value="@players[i].Assists" />

                                <input type="hidden"
                                       name="Players[@i].JerseyImg"
                                       value="@players[i].JerseyImg" />


                                <div class="row g-2 mb-2">

                                    <div class="col-6">
                                        <input type="text"
                                               class="form-control"
                                               name="Players[@i].PlayerName"
                                               value="@players[i].PlayerName"
                                               placeholder="Player Name"
                                               maxlength="100"
                                               required />
                                    </div>

                                    <div class="col-6">
                                        <input type="text"
                                               class="form-control"
                                               name="Players[@i].PreferredPosition"
                                               value="@players[i].PreferredPosition"
                                               placeholder="Position"
                                               maxlength="50"
                                               required />
                                    </div>

                                </div>
                            }
                        </div>
                    </form>
                            
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">Save</button>
                        </div>
                    
                </div>
            </div>
        </div>
     
        <div class="modal fade" id="deleteTeamModal-@team.TeamId" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form method="post" asp-controller="Teams" asp-action="Delete" asp-route-id="@team.TeamId">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title">Delete Team</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <p>
                                Are you sure you want to delete
                                <strong>@team.TeamName</strong>?
                            </p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.teamsData = @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(
                                        Model ?? new List<SoccerPitch.Models.Team>(),
                                        new System.Text.Json.JsonSerializerOptions
                                        {
                                            PropertyNamingPolicy = null
                                        }
                                )
                        );
    </script>
    <script src="~/js/soccerpitch.js?v=2"></script>
    <!-- End of Script-->
</body>
</html>